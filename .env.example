# Copy this file to .env and adjust as needed.

# Port the server listens on
PORT=3000

# Optional fixed service code (the PIN listeners use to join).
# Leave blank to auto-generate a new 4-digit code each time the speaker page loads.
DEFAULT_SERVICE_CODE=

# Optional shared key the speaker must enter before streaming, so random
# visitors cannot inject transcripts into a service. Leave blank to disable.
SPEAKER_KEY=

# Seconds of quiet (in milliseconds) before a sentence is finalized and replaced
# by its full-sentence translation. Lower = snappier, higher = fewer split sentences.
PAUSE_MS=1500

# Force a sentence to close after this many words so a long one never stalls.
MAX_WORDS=45
